@base_url = http://localhost:5000
@token = 
@refresh_token =


# --------------------------------------------------
# AUTH
# --------------------------------------------------

### Login
# @name login
POST {{base_url}}/api/auth
Content-Type: application/json

{
  "email": "developer@gmail.com",
  "password": "password",
  "remember": false
}

### Token
@token = {{login.response.body.data.token}}

### Refresh Token
# @name reauth
GET {{base_url}}/api/auth/refresh
Cookie: x-token={{refresh_token}}

### Logout
GET {{base_url}}/api/auth/logout
Authorization: Bearer {{token}}



# --------------------------------------------------
# USERS
# --------------------------------------------------

### Get Users
GET {{base_url}}/api/users?page=1&search=&limit=10
Authorization: Bearer {{token}}


### Get User By ID
GET {{base_url}}/api/users/{id}
Authorization: Bearer {{token}}


### Create User
POST {{base_url}}/api/users
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "group_id": 3,
  "name": "User",
  "email": "user@gmail.com",
  "password": "password",
  "biodata": "-"
}


### Update User
PUT {{base_url}}/api/users/{id}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "group_id": 3,
  "name": "User",
  "email": "user@gmail.com",
  "password": null,
  "biodata": "-"
}


### Delete User
DELETE {{base_url}}/api/users/{id}
Authorization: Bearer {{token}}


# --------------------------------------------------
# GROUP
# --------------------------------------------------

### Get Group
GET {{base_url}}/api/groups
Authorization: Bearer {{token}}

### Get Access
GET {{base_url}}/api/groups/{id}
Authorization: Bearer {{token}}

### Access Group
PUT {{base_url}}/api/groups/{id}
Authorization: Bearer {{token}}
Content-Type: application/json

[
  {
    "sidebar_key": "master",
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
]

# --------------------------------------------------
# PROFILE
# --------------------------------------------------

### Get Profile
GET {{base_url}}/api/profile
Authorization: Bearer {{token}}


### Update Profile
PUT {{base_url}}/api/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Developer",
  "email": "developer@gmail.com",
  "password": null,
  "biodata": "-"
}

### Sidebar Access
GET {{base_url}}/api/profile/access
Authorization: Bearer {{token}}

# --------------------------------------------------
# SIDEBARS
# --------------------------------------------------

### GET SIDEBAR
GET {{base_url}}/api/sidebars
Authorization: Bearer {{token}}

### CREATE SIDEBAR
POST {{base_url}}/api/sidebars
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "key": "master",
  "parent_key": null,
  "seq": 1,
  "name": "Master",
  "icon": "database",
  "route": "/"
}

### REMOVE SIDEBAR
DELETE {{base_url}}/api/sidebars/master
Authorization: Bearer {{token}}